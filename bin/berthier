#!/usr/bin/env bash
# berthier - multi-step Fleet conventions as deterministic commands.
set -euo pipefail

root=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)

usage() {
  cat <<'EOF'
usage: berthier <command> [args]

project-new <name> <dir> [brief]    create a Project workspace with a Main Agent
task-split <task> <brief>           (Main Agent) split a Task into a 󱎦 worktree workspace
task-done <task>                    (Main Agent) remove a Task's worktree workspace
report "<line>"                     (any Agent) one-line status for the user; "needs you: ..." when they must act
ask <corps> "<request>"             (any Agent) request work from another Corps, delivered when it is idle
owners                              who owns what, to know whom to ask
counts                              Agent count per status plus reports, as JSON for status bars
hook-stop                           Claude Code Stop hook: no turn ends without a report
tick                                run one Main Loop pass
loop                                run the Main Loop forever
EOF
}

cmd=${1:-}
[[ -n $cmd ]] || { usage; exit 2; }
shift
case $cmd in
  -h|--help|help) usage ;;
  project-new|task-split|task-done|report|ask|owners|counts|hook-stop|tick|loop)
    exec "$root/libexec/$cmd" "$@" ;;
  *) usage >&2; exit 2 ;;
esac
