[Unit]
Description=Berthier Main Loop (Grand Army supervision in Herdr)

[Service]
Type=simple
WorkingDirectory=%h/Documents/grand-army
# Build aside and rename: two units start at once, and Agents exec bin/berthier meanwhile.
ExecStartPre=/bin/sh -c 'go build -o bin/.berthier.%N ./cmd/berthier && mv -f bin/.berthier.%N bin/berthier'
ExecStart=%h/Documents/grand-army/bin/berthier loop
Environment=PATH=%h/.nix-profile/bin:%h/.local/bin:%h/.local/share/go/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
