[Unit]
Description=Berthier console (live Grand Army page on 127.0.0.1:8430)

[Service]
Type=simple
WorkingDirectory=%h/Documents/grand-army
ExecStartPre=/usr/bin/env go build -o bin/berthier ./cmd/berthier
ExecStart=%h/Documents/grand-army/bin/berthier dashboard
Environment=PATH=%h/.nix-profile/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
