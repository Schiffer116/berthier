#!/usr/bin/env bash
# Print the Main Loop's event log (state/loop.log, JSON Lines) readably:
# local time, kind, message. -n lines (default 40), -f to follow.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

n=40 follow=()
while (($#)); do
  case $1 in
    -n) n=${2:?}; shift 2 ;;
    -f) follow=(-f); shift ;;
    *) die "usage: berthier log [-n lines] [-f]" ;;
  esac
done
[[ -e $BERTHIER_LOG ]] || exit 0
tail -n "$n" "${follow[@]}" "$BERTHIER_LOG" \
  | jq -Rr --unbuffered 'fromjson? | objects | "\(.ts | strflocaltime("%F %T"))  \(.kind | . + " " * (15 - length))  \(.msg)"'
