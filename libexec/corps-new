#!/usr/bin/env bash
# Create a Corps: a Herdr workspace labelled <name> at <dir>, with a Main
# Agent started there and given its Brief. A brand-new directory becomes a git
# repo so the Main Agent can spawn Divisions from it.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -ge 2 ]] || die "usage: berthier corps-new <name> <dir> [brief]"
name=$1 dir=$2 brief=${3:-}
[[ $name != berthier ]] || die "reserved corps name: $name"
hd workspace list | jq -e --arg l "$name" 'any(.result.workspaces[]; .label == $l)' >/dev/null \
  && die "a workspace labelled '$name' already exists"

dir=$(realpath -m "$dir")
if [[ ! -e $dir ]]; then
  mkdir -p "$dir"
  git -C "$dir" init -q
  git -C "$dir" commit -q --allow-empty -m "Initial commit"
fi

pane=$(hd workspace create --cwd "$dir" --label "$name" --no-focus | jq -re '.result.root_pane.pane_id')
agent=$(slug "$name")
case $(start_claude "$agent" "$pane" "$brief") in
  ready) echo "corps '$name' ready: workspace pane $pane, Main Agent '$agent'" ;;
  blocked) echo "corps '$name' created: pane $pane, Main Agent '$agent' is waiting on a startup dialog (likely folder trust) - the user must answer it in Herdr" ;;
  *) die "corps '$name' created (pane $pane) but its Main Agent did not start" ;;
esac
