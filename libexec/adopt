#!/usr/bin/env bash
# Make a workspace a Division of a Corps: record its Corps in
# state/divisions.json; the label stays. Its Agents keep running; the Corps's Main Agent now commands them, and the Main
# Loop sends their trouble there instead of to Berthier.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -eq 2 ]] || die "usage: berthier adopt <workspace> <corps>"
child=$1 corps=$2
[[ $child != "$corps" ]] || die "a Corps cannot adopt itself"
ws=$(hd workspace list)
child_id=$(jq -r --arg l "$child" '.result.workspaces[] | select(.label == $l) | .workspace_id' <<<"$ws")
[[ -n $child_id ]] || die "no workspace labelled '$child'"
jq -e --arg l "$corps" 'any(.result.workspaces[]; .label == $l)' <<<"$ws" >/dev/null || die "no Corps '$corps'"
divisions=$(cat "$BERTHIER_DIVISIONS" 2>/dev/null || echo '{}')
is_division() { jqn -en --arg l "$1" --argjson d "$divisions" '$l | is_division($d)' >/dev/null; }
if [[ $child == */* ]] || is_division "$child"; then die "'$child' is already a Division"; fi
[[ $child != berthier ]] || die "berthier answers to the user only"
if [[ $corps == */* ]] || is_division "$corps"; then die "'$corps' is a Division, not a Corps"; fi

division_set "$(corps_name "$child")" "$(jq -cn --arg c "$corps" '{corps: $c, worktree: false}')"
log "adopted $child into $corps"
echo "'$child' is now a Division of $corps; brief $corps's Main Agent that it commands it"
