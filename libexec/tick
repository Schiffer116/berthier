#!/usr/bin/env bash
# One Main Loop pass: observe Herdr, decide (lib/tick.jq), act, write state.
# Only lib/tick.jq writes the Grand Army State; this script gathers the
# observations it asks for and carries out its actions.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

exec 9>"$BERTHIER_HOME/tick.lock"
flock -n 9 || exit 0

# Exit 3 = Herdr unreachable (e.g. not started yet after boot); the loop logs outages.
snap=$(hd api snapshot 2>/dev/null | jq -ce '.result.snapshot' 2>/dev/null) || exit 3
prev='{}'
[[ -s $BERTHIER_STATE ]] && prev=$(cat "$BERTHIER_STATE")
now=$(date +%s)
cfg=$(jq -cn \
  --arg berthier_root "$BERTHIER_ROOT" \
  --argjson blocked_after "$BERTHIER_BLOCKED_AFTER" \
  --argjson long_after "$BERTHIER_LONG_AFTER" \
  --argjson division_settle "$BERTHIER_DIVISION_SETTLE" \
  --argjson revive_max "$BERTHIER_REVIVE_MAX" \
  --argjson revive_backoff "$BERTHIER_REVIVE_BACKOFF" \
  --argjson revive_reset "$BERTHIER_REVIVE_RESET" \
  --argjson escalation_ttl "$BERTHIER_ESCALATION_TTL" \
  --argjson speak_after "$BERTHIER_SPEAK_AFTER" \
  --argjson ask_stuck "$BERTHIER_ASK_STUCK" \
  --argjson pingpong_max "$BERTHIER_PINGPONG_MAX" \
  --argjson limit_grace "$BERTHIER_LIMIT_GRACE" \
  --argjson limit_retry "$BERTHIER_LIMIT_RETRY" \
  --argjson budget_warn "$BERTHIER_BUDGET_WARN" \
  --argjson restart_gap "$BERTHIER_RESTART_GAP" \
  --argjson restart_wait "$BERTHIER_RESTART_WAIT" \
  --argjson restart_settle "$BERTHIER_RESTART_SETTLE" \
  '$ARGS.named')

inbox=$(find "$BERTHIER_INBOX" -maxdepth 1 -name '*.json' -print0 \
  | xargs -0r jq -c '. + {id: (input_filename | split("/") | last | rtrimstr(".json"))}' | jq -cs .)

# Fold new quota samples into the usage record the budgets are judged on.
usage=$(usage_update 2>/dev/null) || usage=$(cat "$BERTHIER_USAGE" 2>/dev/null || echo '{}')
usage=$(jq -c 'del(.sessions, .acc)' <<<"$usage" 2>/dev/null) || usage='{}'
budgets=$(cat "$BERTHIER_BUDGETS" 2>/dev/null) && jq -e type <<<"$budgets" >/dev/null 2>&1 || budgets='{}'

decide() { # [obs]
  jq -cn --argjson prev "$prev" --argjson snap "$snap" --argjson now "$now" --argjson cfg "$cfg" \
    --argjson inbox "$inbox" --argjson usage "$usage" --argjson budgets "$budgets" --argjson divisions "$(cat "$BERTHIER_DIVISIONS" 2>/dev/null || echo '{}')" \
    ${1:+--argjson obs "$1"} -L "$BERTHIER_ROOT/lib" -f "$BERTHIER_ROOT/lib/tick.jq"
}

# --- Observe what the decisions need: most ticks need nothing, else one more run.
# A pane that cannot be read for a limit stop is left unobserved: read next tick.
# Reads stay on screen (visible): more lines than that make Herdr scroll an idle
# Claude up and back to collect its history, and the user sees it jump.
look() { # pane sid want...
  local pane=$1 sid=$2 w o='{}' r
  shift 2
  for w; do
    case $w in
      exited)
        r=false
        hd pane read "$pane" --source recent-unwrapped --lines 20 2>/dev/null | exited_deliberately "$sid" && r=true
        o=$(jq -c --argjson r "$r" '.exited = $r' <<<"$o") ;;
      at_shell)
        r=false
        pane_at_shell "$pane" 2>/dev/null && r=true
        o=$(jq -c --argjson r "$r" '.at_shell = $r' <<<"$o") ;;
      interrupted)
        r=false
        transcript_interrupted "$sid" && r=true
        o=$(jq -c --argjson r "$r" '.interrupted = $r' <<<"$o") ;;
      limit_reset)
        r=$(hd pane read "$pane" --source visible 2>/dev/null | usage_limit_reset "$now") || continue
        o=$(jq -c --arg r "$r" '.limit_reset = ($r | if . == "" then null else tonumber end)' <<<"$o") ;;
    esac
  done
  jq -cn --arg p "$pane" --argjson o "$o" '{($p): $o}'
}
out=$(decide)
if [[ $(jq '.look | length' <<<"$out") != 0 ]]; then
  obs=$(while IFS=$'\t' read -r pane sid want; do
    # shellcheck disable=SC2086  # want is a space-separated list
    look "$pane" "$sid" $want
  done < <(jq -r '.look[] | [.pane_id, (.session_id // "-"), (.want | join(" "))] | @tsv' <<<"$out") | jq -cs 'add // {}')
  out=$(decide "$obs")
fi
# --- Log the decisions, then carry out the actions and log their outcomes.
# Each action comes as a line of fields and a line of its event's fields (ev).
while IFS= read -r e; do
  [[ -n $e ]] && jq -c --argjson ts "$(date +%s)" '{ts: $ts} + .' <<<"$e" >>"$BERTHIER_LOG"
done < <(jq -c '.events[]' <<<"$out")
actions() { jq -r ".$1[] | ($2 | @tsv), (.ev | tojson)" <<<"$out"; }

# --- Revive: resume the gone session in the pane it died in.
while IFS=$'\t' read -r pane name sid && IFS= read -r ev; do
  model=$(division_model "$(jq -r --arg p "$pane" '.state.agents[$p].workspace_label // ""' <<<"$out")")
  if hd agent start "$name" --kind claude --pane "$pane" --timeout "$BERTHIER_START_TIMEOUT_MS" \
       -- --resume "$sid" ${model:+--model "$model"} >/dev/null 2>&1; then
    event revived "revived $name in $pane (session $sid)" "$ev"
  else
    event revive_failed "revive failed: $name in $pane (session $sid)" "$ev"
  fi
done < <(actions revive '[.pane_id, .name, .session_id]')

# --- Give agents back the names Herdr forgot (e.g. across a restart).
while IFS=$'\t' read -r pane name sid && IFS= read -r ev; do
  if hd agent rename "$pane" "$name" >/dev/null 2>&1; then
    event renamed "restored name $name in $pane (session $sid)" "$ev"
  else
    event rename_failed "name restore failed: $name in $pane (session $sid)" "$ev"
  fi
done < <(actions rename '[.pane_id, .name, .session_id]')

# --- Usage limits: nudge an Agent on once its limit has reset.
while IFS=$'\t' read -r pane name && IFS= read -r ev; do
  if err=$(prompt_agent "$pane" "$BERTHIER_LIMIT_PROMPT" 2>&1); then
    event resumed "resumed $name in $pane: usage limit reset" "$ev"
  else
    event resume_failed "resume failed: $name in $pane (usage limit reset): $err" "$(with_why "$ev" "$err")"
  fi
done < <(actions resume '[.pane_id, .name]')

# --- Restart: nudge an Agent whose turn the restart cut off, once.
while IFS=$'\t' read -r pane name && IFS= read -r ev; do
  if err=$(prompt_agent "$pane" "$BERTHIER_RESTART_PROMPT" 2>&1); then
    event continued "continued $name in $pane: restart interrupted its turn" "$ev"
  else
    event continue_failed "continue failed: $name in $pane (restart): $err" "$(with_why "$ev" "$err")"
  fi
done < <(actions proceed '[.pane_id, .name]')

# --- Deliver asks; a delivered ask leaves the inbox.
while IFS=$'\t' read -r id pane from to text && IFS= read -r ev; do
  if err=$(prompt_agent "$pane" "$text" 2>&1); then
    rm -f "$BERTHIER_INBOX/$id.json"
    event delivered "delivered ask $from -> $to ($pane)" "$ev"
  else
    event delivery_failed "ask delivery failed: $from -> $to ($pane), ask $id: $err" "$(with_why "$ev" "$err")"
  fi
done < <(actions deliver '[.id, .pane_id, .from, .to, .text]')

# --- Escalate: a Division's events go to its Corps's Main Agent, the rest to
# Berthier, one prompt each. Fall back to the user if the target cannot take it.
berthier=$(jq -r '.state.berthier // empty' <<<"$out")
while IFS= read -r group; do
  [[ -n $group ]] || continue
  to=$(jq -r '.[0].to // "-"' <<<"$group")
  who=$(jq -r '.[0].ev.to' <<<"$group")
  mapfile -t lines < <(jq -r '.[].text' <<<"$group")
  mapfile -t evs < <(jq -c '.[].ev' <<<"$group")
  head=$(jq -r '.[0].head // empty' <<<"$group")
  if [[ $to == - ]]; then target=$berthier msg=${head:-"[berthier-loop] Grand Army events:"}
  else target=$to msg=${head:-"[berthier-loop] Events in your Divisions (you command them):"}; fi
  for l in "${lines[@]}"; do msg+=$'\n'"- $l"; done
  if [[ -n $target ]] && prompt_agent "$target" "$msg" 2>/dev/null; then
    for i in "${!lines[@]}"; do
      event escalated "escalated $(jq -r .why <<<"${evs[i]}") to $who: ${lines[i]}" "${evs[i]}"
    done
  else
    hd notification show "Berthier unreachable" --body "$msg" --sound request >/dev/null 2>&1 || true
    event unreachable "$who unreachable; notified user of ${#lines[@]} event(s)" \
      "$(jq -cn --arg to "$who" --argjson n "${#lines[@]}" '{to: $to, events: $n}')"
  fi
done < <(jq -c '.escalate | group_by([.to // "-", .head // ""])[]' <<<"$out")

# --- Berthier's own trouble goes straight to the user.
while IFS=$'\t' read -r l && IFS= read -r ev; do
  hd notification show "Berthier needs you" --body "$l" --sound request >/dev/null 2>&1 || true
  event notified "notified user: $l" "$ev"
done < <(actions notify '[.text]')

# --- Say it out loud when the user is needed; one utterance per tick.
mapfile -t spoken < <(jq -r '.speak[].text' <<<"$out")
mapfile -t evs < <(jq -c '.speak[].ev' <<<"$out")
if ((${#spoken[@]})); then
  msg=$(printf '%s. ' "${spoken[@]}")
  kind=spoke said=spoke
  [[ -x $BERTHIER_SPEAK ]] && "$BERTHIER_SPEAK" "${msg% }" >/dev/null 2>&1 || kind=speak_failed said="speak failed ($BERTHIER_SPEAK)"
  for i in "${!spoken[@]}"; do event "$kind" "$said: ${spoken[i]}." "${evs[i]}"; done
fi

tmp=$(mktemp "$BERTHIER_HOME/state.json.XXXXXX")
jq '.state' <<<"$out" >"$tmp"
mv "$tmp" "$BERTHIER_STATE"
