#!/usr/bin/env bash
# Run by a Main Agent from its own pane: split a Task off its Project into a
# worktree workspace labelled "󱎦 <project>/<task>" and start an Agent there.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -ge 2 ]] || die "usage: berthier task-split <task> <brief>"
task=$1
shift
brief=$*
ws_id=${BERTHIER_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}
[[ -n $ws_id ]] || die "run this from the Main Agent's Herdr pane (no HERDR_WORKSPACE_ID)"

project=$(hd workspace get "$ws_id" | jq -r '.result.workspace.label')
[[ $project != "$TASK_PREFIX"* ]] || die "already inside a Task; split from the Project's own workspace"
# Herdr fills in workspace git metadata lazily, so ask git from a pane's cwd.
cwd=$(hd pane list --workspace "$ws_id" | jq -r '.result.panes[0].cwd')
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
  || die "Project '$project' is not a git repository; Tasks need a worktree"
repo=$(dirname "$common")

branch=$(slug "$task")
[[ -n $branch ]] || die "task name must contain letters"
label="$TASK_PREFIX$project/$branch"
pane=$(hd worktree create --cwd "$repo" --branch "$branch" --label "$label" --no-focus \
  | jq -re '.result.root_pane.pane_id') || die "could not create worktree for branch '$branch'"

agent=$(slug "$project-$branch")
if hd agent start "$agent" --kind claude --pane "$pane" --timeout "$BERTHIER_START_TIMEOUT_MS" \
     -- ${brief:+"$brief"} >/dev/null 2>&1; then
  echo "task '$label' started: branch $branch, pane $pane, agent '$agent'"
else
  echo "task '$label' created: pane $pane, agent '$agent' is waiting on a startup dialog - the user must answer it in Herdr"
fi
