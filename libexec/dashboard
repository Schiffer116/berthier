#!/usr/bin/env bash
# Serve the Grand Army console (dashboard/) on 127.0.0.1:8430, rebuilding the Go
# server first whenever its sources changed. Extra args go to the server
# (e.g. -addr :9000).
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

src=$BERTHIER_ROOT/dashboard
bin=$src/.bin/berthier-dashboard
if [[ ! -x $bin ]] || [[ -n $(find "$src" -maxdepth 1 -type f -newer "$bin" -print -quit) ]]; then
  (cd "$src" && go build -o "$bin" .) || die "dashboard build failed"
fi
exec "$bin" -berthier "$BERTHIER_ROOT/bin/berthier" "$@"
