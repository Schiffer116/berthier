#!/usr/bin/env bash
# The bar's compact view of `berthier army`: availability, Agent count per
# status, and "report", one line per live Agent ("<who>: <state> - <report>",
# needs-you first; <state> is "needs you" or the live status).
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -eq 0 ]] || die "usage: berthier counts"

"$BERTHIER_ROOT/libexec/army" | jq -c '
  {available} + .counts
  + {report: ([.corps[] | ., .divisions[], .tasks[] | .agents[]] + [.berthier // empty]
      | map(select(.status != "gone"))
      | sort_by((.needs_you | not), .who)
      | map("\(.who): \(if .needs_you then "needs you" else .status end) - \(.report // "no report yet")")
      | join("\n"))}'
