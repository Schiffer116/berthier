#!/usr/bin/env bash
# An Agent's one-line status for the user, shown in the bar's tooltip.
# Start the line with "needs you:" when the user must act. Outside a Herdr
# Claude session this is a no-op, so the global rule is safe everywhere.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -eq 1 && -n $1 ]] || die 'usage: berthier report "<one line: what you are doing, or needs you: ...>"'
sid=${CLAUDE_CODE_SESSION_ID:-}
[[ -n ${HERDR_PANE_ID:-} && -n $sid ]] || exit 0

tmp=$(mktemp "$BERTHIER_REPORTS/.report.XXXXXX")
jq -cn --arg line "$1" --arg pane "$HERDR_PANE_ID" --argjson at "$(date +%s)" \
  '{line: ($line | gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" ") | .[:200]), pane: $pane, at: $at}' >"$tmp"
mv "$tmp" "$BERTHIER_REPORTS/$sid.json"
