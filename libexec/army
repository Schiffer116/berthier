#!/usr/bin/env bash
# Print the Army view model (lib/army.jq) as JSON: every Corps with its
# Divisions, each Agent's live status and own report, what needs the
# user, asks in flight and recent activity. "available" is false when the Main
# Loop has not written state.json recently.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

[[ $# -eq 0 ]] || die "usage: berthier army"

now=$(date +%s)
mtime=$(stat -c %Y "$BERTHIER_STATE" 2>/dev/null || echo 0)
available=false
((now - mtime <= BERTHIER_INTERVAL * 3)) && available=true

json_dir() { # dir -> array of its *.json objects, each with its file name as id
  find "$1" -maxdepth 1 -name '*.json' -print0 \
    | xargs -0r jq -c '. + {id: (input_filename | split("/") | last | rtrimstr(".json"))}' \
    | jq -cs .
}
reports=$(json_dir "$BERTHIER_REPORTS" | jq -c 'map({key: .id, value: .}) | from_entries')
inbox=$(json_dir "$BERTHIER_INBOX")

jq -cn -L "$BERTHIER_ROOT/lib" \
  --argjson state "$(cat "$BERTHIER_STATE" 2>/dev/null || echo '{}')" \
  --argjson reports "$reports" --argjson inbox "$inbox" \
  --argjson log "$(tail -n 2000 "$BERTHIER_LOG" 2>/dev/null | jq -Rcs 'split("\n") | map(select(. != ""))')" \
  --argjson available "$available" --argjson now "$now" --argjson interval "$BERTHIER_INTERVAL" \
  -f "$BERTHIER_ROOT/lib/army.jq"
