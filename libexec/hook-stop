#!/usr/bin/env bash
# Claude Code Stop hook: an Agent in Herdr may not end a turn without having
# run `berthier report` during it. Reads the hook's JSON on stdin.
# shellcheck source=lib/common.sh
source "$(dirname "$(readlink -f "$0")")/../lib/common.sh"

input=$(cat)
[[ -n ${HERDR_PANE_ID:-} ]] || exit 0
[[ $(jq -r '.stop_hook_active // false' <<<"$input") == true ]] && exit 0
sid=$(jq -r '.session_id // empty' <<<"$input")
transcript=$(jq -r '.transcript_path // empty' <<<"$input")
[[ -n $sid && -f $transcript ]] || exit 0

# The turn began at the last real user message (not a tool result).
turn_start=$(jq -r 'select(.type == "user" and (.isMeta | not)
    and (.message.content | type == "string" or (type == "array" and any(.[]; .type == "text"))))
  | .timestamp' "$transcript" | tail -1)
[[ -n $turn_start ]] || exit 0
turn_start=$(date -d "$turn_start" +%s)
reported=$(jq -r '.at // 0' "$BERTHIER_REPORTS/$sid.json" 2>/dev/null || echo 0)
((reported >= turn_start)) && exit 0

jq -cn '{decision: "block", reason: "Before stopping, run: berthier report \"<one line for the user: what you did or are doing; start with needs you: if they must act>\""}'
